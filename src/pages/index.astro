---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Starfield from '../components/Starfield.astro';
import GameCard from '../components/GameCard.astro';
import { games } from '../data/games';

const pillars = [
  {
    title: 'Fun first',
    text: 'If a game is not fun, nobody learns anything from it. Every project starts as something we would want to play ourselves.',
  },
  {
    title: 'Skills that stick',
    text: 'Typing, reflexes, reading, problem solving. We hide the practice inside the play so progress feels like winning.',
  },
  {
    title: 'Safe by design',
    text: 'Built for kids, classrooms and families. No dark patterns, no surprise purchases, no creepy tracking.',
  },
];
---

<Base>
  <section class="hero">
    <Starfield />
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <Logo size={132} class="hero-logo" />
      <h1>
        <span class="line">Geurts</span>
        <span class="line accent">Gaming</span>
      </h1>
      <p class="sub">Games kids love. Skills that stick.</p>
      <p class="lede muted">
        We're an indie studio making educational and seriously fun games for kids and teenagers.
      </p>
      <div class="cta">
        <a href="#games" class="btn">See our games</a>
        <a href="/about/" class="btn ghost">About the studio</a>
      </div>
    </div>
    <a href="#games" class="scroll" aria-label="Scroll to games">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </section>

  <section id="games" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our games</p>
        <h2>Two worlds, one mission</h2>
        <a href="/games/" class="more">All games →</a>
      </div>
      <div class="games-grid">
        {games.map((g, i) => <GameCard game={g} featured={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="section pillars-wrap">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we build</p>
        <h2>Play is the point</h2>
      </div>
      <div class="pillars">
        {pillars.map((p, i) => (
          <div class="pillar card">
            <span class="num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap band card">
      <div class="band-copy">
        <p class="eyebrow">Teachers, parents, players</p>
        <h2>Want to work with us?</h2>
        <p class="muted">Classroom pilots, feedback, press, or just to say hi — we'd love to hear from you.</p>
      </div>
      <a href="/contact/" class="btn">Get in touch</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 50% at 50% 110%, color-mix(in srgb, var(--plum) 55%, transparent), transparent 70%),
      linear-gradient(180deg, #050f33 0%, var(--navy) 45%, #12245f 100%);
    padding-block: clamp(104px, 22vw, 120px) clamp(88px, 14vw, 100px);
  }
  .glow {
    position: absolute;
    left: 50%; top: 42%;
    width: min(70vw, 760px); aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--lapis) 70%, transparent) 0%, transparent 65%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-inner { position: relative; display: grid; justify-items: center; gap: 10px; }
  :global(.hero-logo) {
    width: clamp(92px, 26vw, 132px);
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(8, 24, 73, 0.8));
    margin-bottom: clamp(8px, 2vw, 18px);
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

  h1 {
    display: grid;
    font-size: clamp(2.6rem, 11vw, 5rem);
    line-height: 0.95;
    letter-spacing: 0.08em;
    margin: 0;
    text-shadow: 0 0 40px rgba(236, 223, 210, 0.15);
  }
  .line { display: block; }
  .accent { color: var(--accent-bright); text-shadow: 0 0 50px color-mix(in srgb, var(--accent) 60%, transparent); }

  .sub {
    margin-top: clamp(14px, 3vw, 22px);
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1.8vw, 1.2rem);
    letter-spacing: clamp(0.14em, 1.2vw, 0.3em);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--silver);
  }
  .lede { max-width: 540px; font-size: clamp(1rem, 1.6vw, 1.1rem); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 10px; }
  @media (max-width: 420px) {
    .cta { width: 100%; flex-direction: column; }
    .cta .btn { justify-content: center; }
  }

  .scroll {
    position: absolute;
    bottom: calc(14px + env(safe-area-inset-bottom)); left: 50%;
    display: grid; place-items: center;
    width: 44px; height: 44px;
    transform: translateX(-50%);
    color: var(--silver);
    opacity: 0.7;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob { 0%, 100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 8px); } }

  .more { display: inline-flex; align-items: center; min-height: 44px; font-weight: 800; color: var(--accent-text); padding: 6px 0; }
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
    margin-top: 28px;
  }

  .pillars-wrap { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--lapis) 25%, transparent)); }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .pillar { padding: clamp(22px, 5vw, 28px); position: relative; }
  .num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.4rem;
    color: var(--accent-text);
    line-height: 1;
    display: block;
    margin-bottom: 14px;
  }

  .band {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 24px;
    padding: clamp(28px, 5vw, 56px);
    background: linear-gradient(135deg, var(--lapis), var(--plum));
    border-color: color-mix(in srgb, var(--sand) 20%, transparent);
  }
  .band-copy { max-width: 560px; }
  .band .eyebrow { color: var(--sand); opacity: 0.8; }
  .band h2 { margin-bottom: 8px; }
  .band p:last-child { margin: 0; color: var(--sand); opacity: 0.85; }
</style>
