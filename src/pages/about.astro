---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Logo from '../components/Logo.astro';
import earl from '../assets/earl.png';
import edna from '../assets/edna.png';
---

<Base title="About" description="GeurtsGaming is an indie studio making educational and fun games for kids and teenagers.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">About the studio</p>
      <h1>Small team.<br />Big imagination.</h1>
      <p class="lede muted">
        GeurtsGaming is an indie game studio with one simple belief: kids learn best when they forget they're learning.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap story">
      <div class="text">
        <h2>Why we make games</h2>
        <p>
          Most "educational" games feel like homework with a coat of paint. We started GeurtsGaming to flip that around:
          take the stuff kids already love about games — competition, progress, friends, a little chaos — and let real skills
          ride along for free.
        </p>
        <p>
          <strong>Cool Typing Games</strong> came first: live multiplayer typing races and battles that teachers can drop
          straight into a classroom. <strong>Earl vs. The Mutants</strong> is our love letter to teens who want something
          bigger — a full wasteland road trip on Steam.
        </p>
        <p>
          We build everything in-house, from code to characters, and we playtest with the people who matter most: actual kids.
        </p>
      </div>
      <div class="art" aria-hidden="true">
        <Image src={edna} alt="" width={240} class="edna" />
        <Image src={earl} alt="" width={240} class="earl" />
        <Logo size={120} class="badge" />
      </div>
    </div>
  </section>

  <section class="section values">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we care about</p>
        <h2>Our promises</h2>
      </div>
      <ul class="list">
        <li><strong>Kid-safe.</strong> No ads aimed at children, no manipulative purchases, no selling data.</li>
        <li><strong>Teacher-friendly.</strong> Easy to set up, easy to supervise, works on whatever the school already has.</li>
        <li><strong>Genuinely fun.</strong> If it doesn't pass the "one more round" test with real kids, it doesn't ship.</li>
        <li><strong>Always improving.</strong> We listen to players and parents and keep shipping updates.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    --hero-glow: color-mix(in srgb, var(--lapis) 70%, transparent);
  }

  .story {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }
  .text p { font-size: 1.08rem; }
  .art {
    position: relative;
    min-height: 420px;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--lapis), var(--plum));
    overflow: hidden;
  }
  /* Sized by the panel's height so the characters are never cropped; they flank the badge from the centre. */
  .art :global(img) {
    position: absolute;
    bottom: -10px;
    height: 94%;
    width: auto;
    max-width: 46%;
    object-fit: contain;
    object-position: bottom;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.45));
  }
  .art :global(.edna) { right: 52%; }
  .art :global(.earl) { left: 52%; }
  .art :global(.badge) { position: relative; z-index: 1; transform: translateY(-80px); filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.5)); }

  .values { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--lapis) 25%, transparent)); }
  .list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 18px;
  }
  .list li {
    padding: 22px 24px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--surface-border);
    color: var(--text-muted);
  }
  .list strong { color: var(--sand); display: block; margin-bottom: 4px; font-family: var(--font-display); letter-spacing: 0.05em; text-transform: uppercase; font-size: 0.9rem; }

  @media (max-width: 800px) {
    .story { grid-template-columns: 1fr; gap: 32px; }
    .art { min-height: 300px; }
    .art :global(.badge) { width: 96px; height: 96px; transform: translateY(-56px); }
    .list li { padding: 18px 20px; }
  }
</style>
