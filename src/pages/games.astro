---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import { getImage } from 'astro:assets';
import { games } from '../data/games';

// Structured data: one VideoGame entry per game, generated from games.ts.
const site = Astro.site ?? 'https://geurtsgaming.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'GeurtsGaming games',
  itemListElement: await Promise.all(
    games.map(async (g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoGame',
        name: g.title,
        description: g.description,
        url: g.url,
        image: new URL((await getImage({ src: g.image, width: 1200 })).src, site).href,
        gamePlatform: g.platform.split(' · '),
        publisher: { '@type': 'Organization', name: 'GeurtsGaming', url: 'https://geurtsgaming.com' },
      },
    })),
  ),
};
---

<Base title="Games" description="Every game from GeurtsGaming: Cool Typing Games for kids and classrooms, and Earl vs. The Mutants on Steam.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Our games</p>
      <h1>Pick your world</h1>
      <p class="lede muted">
        From classroom-friendly typing races to a mutant-blasting road trip. Every game is built to be fun first, and good for you second.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top: 0">
    <div class="wrap grid">
      {games.map((g, i) => <GameCard game={g} featured={i === 0} headingLevel={2} />)}
    </div>
  </section>
</Base>

<style>
  .page-hero {
    background:
      radial-gradient(ellipse 60% 60% at 50% 0%, color-mix(in srgb, var(--plum) 50%, transparent), transparent 70%),
      linear-gradient(180deg, #050f33, var(--navy));
  }
  .lede { max-width: 620px; font-size: clamp(1.02rem, 1.6vw, 1.15rem); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 28px;
  }
</style>
