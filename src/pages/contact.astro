---
import Base from '../layouts/Base.astro';
import { games } from '../data/games';
const email = 'hello@geurtsgaming.com';
---

<Base title="Contact" description="Get in touch with GeurtsGaming for classroom pilots, press, feedback or partnerships.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Say hello</h1>
      <p class="lede muted">
        Teachers, parents, players, press — we read everything. Pick the fastest route below.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap cards">
      <a class="card contact" href={`mailto:${email}`}>
        <span class="icon" aria-hidden="true">✉</span>
        <h2>Email</h2>
        <p class="muted">Partnerships, press and anything else.</p>
        <span class="link">{email}</span>
      </a>
      {games.map((g) => (
        <a class="card contact" href={g.url} target="_blank" rel="noopener">
          <span class="icon" aria-hidden="true">🎮</span>
          <h2>{g.title}</h2>
          <p class="muted">Support, bugs and feedback for this game.</p>
          <span class="link">{g.url.replace('https://', '')}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-hero {
    background:
      radial-gradient(ellipse 60% 60% at 50% 0%, color-mix(in srgb, var(--magenta) 40%, transparent), transparent 70%),
      linear-gradient(180deg, #050f33, var(--navy));
  }
  .lede { max-width: 560px; font-size: clamp(1.02rem, 1.6vw, 1.15rem); }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .contact {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  @media (hover: hover) {
    .contact:hover { transform: translateY(-4px); border-color: var(--accent); }
  }
  @media (max-width: 480px) { .contact { padding: 22px; } }
  .icon { font-size: 1.8rem; margin-bottom: 8px; }
  .contact h2 { font-size: clamp(1.15rem, 2vw, 1.4rem); }
  .contact p { flex: 1; }
  .link { font-weight: 800; color: var(--accent-text); word-break: break-all; }
</style>
