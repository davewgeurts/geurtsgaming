    color: var(--sand);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .sfx-toggle[aria-pressed='true'] {
    background: color-mix(in srgb, var(--ctg-accent) 28%, #081849);
    border-color: var(--ctg-gold);
    color: #fff;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  .ctg-logo {
    width: min(100%, 460px);
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.55));
    margin-bottom: 16px;
  }

  .hero-kicker {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.85vw, 1.28rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ctg-gold);
    margin-bottom: 12px;
  }

  .hero-lede {
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    color: #f4ebe0;
    max-width: 58ch;
    margin-bottom: 20px;
  }

  /* 3D Keycaps */
  .hero-keydeck {
    padding: 14px 16px;
    margin-bottom: 22px;
    border-radius: 16px;
    background: rgba(7, 17, 54, 0.78);
    border: 1px solid color-mix(in srgb, var(--ctg-accent) 36%, transparent);
    max-width: 540px;
  }
  .keycap-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .keycap-3d {
    min-width: 52px;
    height: 50px;
    padding: 0 14px;
    border-radius: 12px;
    background: linear-gradient(180deg, #1d398f 0%, #10225e 100%);
    border: 2px solid color-mix(in srgb, var(--ctg-accent) 60%, #fff);
    box-shadow: 0 5px 0 #071133, 0 8px 18px rgba(0, 0, 0, 0.4);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 900;
    cursor: pointer;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.15s ease;
  }
  .keycap-3d.zap-cap {
    background: linear-gradient(180deg, #ffd137 0%, #ff8907 100%);
    color: #081849;
    border-color: #fff3b0;
    box-shadow: 0 5px 0 #8c4300;
  }
  .keycap-3d:active,
  .keycap-3d.pressed {
    transform: translateY(4px);
    box-shadow: 0 1px 0 #071133, 0 0 20px var(--ctg-accent);
  }
  .keydeck-status {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0;
    font-size: 0.82rem;
    color: var(--silver);
  }
  .keydeck-status strong {
    font-family: var(--font-display);
    color: var(--ctg-accent);
  }

  /* Arcade Buttons */
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .cta-row.center {
    justify-content: center;
  }

  .arcade-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    padding: 12px 20px;
    border-radius: 14px;
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border: 2px solid transparent;
    transition: transform 0.1s ease, filter 0.15s ease;
    user-select: none;
  }
  .ctg-primary {
    background: linear-gradient(180deg, var(--ctg-accent) 0%, color-mix(in srgb, var(--ctg-accent) 70%, #0a48b5) 100%);
    color: #041226;
    border-color: #d6fbff;
    box-shadow: 0 5px 0 rgba(5, 32, 74, 0.95), 0 14px 28px color-mix(in srgb, var(--ctg-accent) 38%, transparent);
  }
  .ctg-gold {
    background: linear-gradient(180deg, #ffd84d 0%, #ff8907 100%);
    color: #1a0d00;
    border-color: #fff2b2;
    box-shadow: 0 5px 0 #8a4300, 0 14px 28px rgba(255, 160, 24, 0.35);
  }
  .ctg-ghost {
    background: rgba(12, 27, 82, 0.82);
    color: var(--sand);
    border-color: rgba(236, 223, 210, 0.36);
    box-shadow: 0 5px 0 #050d2e;
  }
  .ctg-mini {
    min-height: 42px;
    padding: 8px 15px;
    font-size: 0.75rem;
    background: rgba(16, 35, 98, 0.9);
    color: var(--sand);
    border-color: color-mix(in srgb, var(--ctg-accent) 55%, transparent);
    box-shadow: 0 4px 0 #050d2e;
  }
  @media (hover: hover) {
    .arcade-btn:hover {
      filter: brightness(1.07);
      transform: translateY(-2px);
    }
  }
  .arcade-btn:active {
    transform: translateY(3px);
  }

  /* Tobor Portal */
  .portal-frame {
    position: relative;
    border-radius: 28px;
    padding: 14px;
    background: linear-gradient(145deg, rgba(16, 38, 108, 0.9), rgba(8, 18, 56, 0.95));
    border: 2px solid color-mix(in srgb, var(--ctg-accent) 65%, transparent);
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.55), 0 0 42px color-mix(in srgb, var(--ctg-accent) 26%, transparent);
  }
  .portal-link {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  @media (hover: hover) {
    .portal-link:hover {
      transform: scale(1.015);
    }
  }
  .portal-video {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 18px;
    background: #061238;
  }
  .portal-chip {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(6, 15, 48, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .portal-chip strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--ctg-gold);
  }
  .portal-chip span {
    font-size: 0.82rem;
    color: var(--silver);
  }

  /* ---- 2. Playable Turbo WPM Dash ---- */
  .dash-cabinet {
    margin-top: 28px;
    padding: clamp(18px, 3.5vw, 30px);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(12, 28, 86, 0.92), rgba(7, 17, 54, 0.96));
    border: 2px solid color-mix(in srgb, var(--ctg-accent) 55%, rgba(255, 255, 255, 0.16));
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.45);
  }

  .dash-telemetry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding-bottom: 18px;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .tele-box {
    display: flex;
    flex-direction: column;
  }
  .tele-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .tele-val {
    font-family: var(--font-display);
    font-size: 1.55rem;
    color: #fff;
  }
  .tele-val.streak {
    color: var(--ctg-gold);
  }
  .tele-val small {
    font-size: 0.8rem;
    color: var(--ctg-accent);
  }

  .race-stadium {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 18px;
    border-radius: 18px;
    background:
      linear-gradient(90deg, rgba(6, 15, 48, 0.88), rgba(8, 22, 66, 0.78)),
      url('/games/cool-typing-games/games/turbo_racers_bg.png') center / cover no-repeat;
    border: 1px solid rgba(255, 255, 255, 0.14);
    margin-bottom: 20px;
  }

  .lane-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
  }
  .lane-badge.you {
    color: var(--ctg-gold);
  }
  .lane-badge.rival {
    color: #9beeff;
  }

  .track-rail {
    position: relative;
    height: 52px;
    border-radius: 999px;
    background: rgba(4, 10, 32, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    padding-inline: 12px 44px;
  }
  .nitro-trail {
    height: 14px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--ctg-gold), var(--ctg-accent));
    transition: width 0.14s ease;
  }
  .rival-trail {
    background: linear-gradient(90deg, #5f3475, #3be7ff);
  }
  .racer-token {
    position: absolute;
    top: 50%;
    transform: translate(-12%, -50%);
    width: 52px;
    height: 52px;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.65));
    transition: left 0.14s ease;
  }
  .finish-flag {
    position: absolute;
    right: 14px;
    font-size: 1.25rem;
  }

  .prompt-surface {
    padding: 18px 20px;
    border-radius: 18px;
    background: rgba(5, 12, 40, 0.9);
    border: 2px solid color-mix(in srgb, var(--ctg-accent) 45%, transparent);
    cursor: text;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .prompt-surface:focus {
    outline: none;
    border-color: var(--ctg-gold);
    box-shadow: 0 0 0 4px rgba(255, 209, 55, 0.22);
  }
  .prompt-surface.typo-shake {
    animation: typoWiggle 0.22s ease;
    border-color: #ff5d6c;
  }
  @keyframes typoWiggle {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }

  .prompt-hint {
    font-size: 0.84rem;
    color: var(--silver);
    margin-bottom: 12px;
    text-align: center;
  }

  .prompt-chars {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  :global(.char-tile) {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    height: 42px;
    padding: 0 6px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--sand);
  }
  :global(.char-tile.space) {
    min-width: 44px;
    color: var(--text-muted);
  }
  :global(.char-tile.typed) {
    background: rgba(99, 232, 132, 0.22);
    border-color: #63e884;
    color: #9effb4;
  }
  :global(.char-tile.current) {
    background: var(--ctg-gold);
    border-color: #fff6c2;
    color: #081849;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(255, 209, 55, 0.45);
  }

  .quick-keys-wrap {
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .quick-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .quick-keys {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  :global(.qkey) {
    min-width: 48px;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgba(24, 46, 122, 0.9);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 4px 0 #061033;
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
  }
  :global(.qkey.next-needed) {
    border-color: var(--ctg-gold);
    background: linear-gradient(180deg, #2852d6, #173391);
    box-shadow: 0 4px 0 #061033, 0 0 16px rgba(255, 209, 55, 0.45);
  }

  .dash-finish {
    margin-top: 20px;
    padding: 20px 24px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(59, 231, 255, 0.2), rgba(255, 209, 55, 0.22));
    border: 2px solid var(--ctg-gold);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .dash-finish[hidden] {
    display: none;
  }
  .medal-badge {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--ctg-gold);
    color: #081849;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 900;
  }
  .finish-copy {
    flex: 1;
    min-width: 220px;
  }
  .finish-copy h3 {
    margin-bottom: 4px;
  }
  .finish-copy p {
    margin: 0;
  }
  .finish-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ---- 3. Racer Pod Selector ---- */
  .pods-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 12px;
    margin: 28px 0 24px;
  }
  .racer-pod {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    border-radius: 18px;
    background: rgba(12, 26, 78, 0.72);
    border: 2px solid rgba(255, 255, 255, 0.14);
    color: var(--sand);
    cursor: pointer;
    transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  @media (hover: hover) {
    .racer-pod:hover {
      transform: translateY(-4px);
      border-color: var(--pod-accent);
    }
  }
  .racer-pod.active {
    background: color-mix(in srgb, var(--pod-accent) 22%, rgba(8, 20, 64, 0.92));
    border-color: var(--pod-accent);
    box-shadow: 0 14px 30px -14px var(--pod-accent);
  }
  .pod-ring {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    padding: 6px;
    background: radial-gradient(circle, color-mix(in srgb, var(--pod-accent) 36%, transparent), rgba(5, 12, 40, 0.9));
    border: 2px solid color-mix(in srgb, var(--pod-accent) 65%, transparent);
    display: grid;
    place-items: center;
  }
  .pod-ring img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pod-name {
    font-family: var(--font-display);
    font-size: 0.74rem;
    text-align: center;
  }
  .pod-species {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .bio-card {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 26px;
    align-items: center;
    padding: 26px;
    border-radius: 24px;
    background: linear-gradient(135deg, var(--ctg-glow-low), color-mix(in srgb, var(--ctg-glow-high) 55%, #081849));
    border: 2px solid var(--ctg-accent);
    box-shadow: 0 24px 55px -25px var(--ctg-accent);
    transition: background 0.3s ease, border-color 0.25s ease;
  }
  .bio-art {
    display: grid;
    place-items: center;
    padding: 14px;
    border-radius: 20px;
    background: radial-gradient(circle, color-mix(in srgb, var(--ctg-accent) 30%, transparent), rgba(4, 10, 32, 0.65));
  }
  .bio-art img {
    max-height: 200px;
    width: auto;
    object-fit: contain;
  }
  .bio-tag {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ctg-accent);
    margin-bottom: 4px;
  }
  .bio-cheer {
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 16px;
  }
  .bio-traits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .trait-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--silver);
    margin-bottom: 8px;
  }
  .trait-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  :global(.trait-pill) {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 800;
  }
  :global(.trait-pill.good) {
    background: rgba(99, 232, 132, 0.18);
    border: 1px solid rgba(99, 232, 132, 0.55);
    color: #c8ffd6;
  }
  :global(.trait-pill.warn) {
    background: rgba(255, 137, 7, 0.18);
    border: 1px solid rgba(255, 137, 7, 0.55);
    color: #ffe0bd;
  }

  .fish-cameo {
    margin-top: 20px;
    padding: 18px 24px;
    border-radius: 20px;
    background: rgba(11, 27, 82, 0.74);
    border: 1px solid rgba(59, 231, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .fish-tag {
    display: block;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: #3be7ff;
  }
  .fish-copy p {
    margin: 4px 0 0;
    font-size: 0.88rem;
  }
  .fish-avatars {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .fish-chip {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(6, 15, 48, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .fish-chip img {
    width: 42px;
    height: 42px;
    object-fit: contain;
  }
  .fish-chip figcaption {
    font-size: 0.82rem;
    font-weight: 800;
  }

  /* ---- 4. 10-Game Arcade Wall ---- */
  .stage-spotlight {
    position: relative;
    margin: 28px 0 22px;
    border-radius: 24px;
    overflow: hidden;
    border: 2px solid color-mix(in srgb, var(--ctg-accent) 55%, transparent);
  }
  .stage-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.45) saturate(1.15);
  }
  .stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(5, 13, 44, 0.92) 0%, rgba(7, 18, 58, 0.76) 60%, rgba(5, 13, 44, 0.88) 100%);
  }
  .stage-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 26px;
    align-items: center;
    padding: clamp(20px, 3.5vw, 32px);
  }
  .stage-thumb {
    width: 100%;
    border-radius: 16px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.5);
  }
  .stage-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .stage-info h3 {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    margin-bottom: 8px;
  }
  .stage-info p {
    max-width: 60ch;
    margin-bottom: 16px;
  }

  .filter-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 24px;
  }
  .filter-btn {
    min-height: 42px;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(14, 30, 88, 0.78);
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    color: var(--sand);
    font-weight: 800;
    font-size: 0.86rem;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .filter-btn.active {
    background: color-mix(in srgb, var(--ctg-accent) 26%, #0b1c56);
    border-color: var(--ctg-accent);
    color: #fff;
  }

  .cabinets-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  @media (max-width: 680px) {
    .cabinets-grid {
      grid-template-columns: 1fr;
    }
  }
  .cabinet-card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: rgba(12, 26, 78, 0.84);
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cabinet-card[hidden] {
    display: none;
  }
  .cabinet-card.selected {
    border-color: var(--cab-accent);
    box-shadow: 0 20px 44px -24px var(--cab-accent);
  }
  @media (hover: hover) {
    .cabinet-card:hover {
      transform: translateY(-4px);
      border-color: var(--cab-accent);
    }
  }

  .cab-media-btn {
    position: relative;
    padding: 0;
    border: 0;
    background: #061138;
    cursor: pointer;
    aspect-ratio: 16 / 9.6;
    overflow: hidden;
  }
  .cab-media-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  @media (hover: hover) {
    .cab-media-btn:hover img {
      transform: scale(1.04);
    }
  }
  .cab-players {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--cab-accent);
    color: #06122e;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 900;
  }
  .cab-mode {
    position: absolute;
    bottom: 10px;
    right: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(5, 12, 38, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--sand);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .cab-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .cab-skill {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cab-accent);
  }
  .cab-body h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .cab-body p {
    font-size: 0.9rem;
    margin: 0 0 12px;
    flex: 1;
  }
  .cab-actions {
    display: flex;
