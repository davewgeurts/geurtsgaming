    --ctg-gold: #ffd137;
    --ctg-orange: #ff8907;
    background:
      radial-gradient(ellipse 75% 32% at 50% 10%, color-mix(in srgb, var(--ctg-accent) 22%, transparent), transparent 72%),
      linear-gradient(180deg, #06133b 0%, var(--navy) 48%, #07143d 100%);
  }

  .ctg-eyebrow {
    color: var(--ctg-accent);
  }

  /* ---- 1. Hero ---- */
  .ctg-hero {
    position: relative;
    padding-top: clamp(104px, 13vw, 136px);
    padding-bottom: clamp(54px, 8vw, 92px);
    overflow: hidden;
    border-bottom: 2px solid color-mix(in srgb, var(--ctg-accent) 38%, transparent);
    background:
      radial-gradient(circle at 75% 48%, color-mix(in srgb, var(--ctg-accent) 24%, transparent), transparent 52%),
