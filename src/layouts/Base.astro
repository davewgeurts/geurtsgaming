---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Keep the page out of search results (used by the 404 page). */
  noindex?: boolean;
}
const site = 'GeurtsGaming';
const {
  title,
  description = 'GeurtsGaming makes educational and fun games for kids and teenagers — including Cool Typing Games and Earl vs. The Mutants.',
  image = '/og.png',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${site}` : `${site} — Games Kids Love, Learning That Sticks`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://geurtsgaming.com');
const ogImage = new URL(image, Astro.site ?? 'https://geurtsgaming.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#081849" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted (see `fonts` in astro.config.mjs). Only the two faces every page opens with are preloaded. -->
    <Font cssVariable="--font-nunito" preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable="--font-orbitron" preload={[{ weight: 700, subset: 'latin' }]} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site,
      url: 'https://geurtsgaming.com',
      logo: 'https://geurtsgaming.com/logo.svg',
      description,
    })} />
    <!--
      Google tag (gtag.js), set up for a site made for children. Keep these settings in step with what
      /privacy/ says: no advertising storage or signals, no ad personalisation, and an analytics cookie that
      is deleted when the browser is closed (cookie_expires: 0). These are set with gtag('set', ...) before
      the tag is configured: passed to gtag('config', ...) instead, the cookie setting is ignored (checked
      in a browser: the cookies then last 400 days).
    -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R00Y85816Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'granted',
      });
      gtag('set', {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
        cookie_expires: 0,
      });
      gtag('js', new Date());
      gtag('config', 'G-R00Y85816Z');
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip:focus {
    position: fixed; left: 16px; top: 16px; z-index: 100;
    width: auto; height: auto; margin: 0; padding: 12px 16px;
    clip: auto; overflow: visible; white-space: normal;
    background: var(--accent); color: var(--sand); border-radius: 8px; font-weight: 800;
  }
</style>
