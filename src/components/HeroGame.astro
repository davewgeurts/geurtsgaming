---
/**
 * Launch button for the hero arcade game, plus the full-screen overlay it plays in (with its Pause, Sound and Exit buttons).
 * The game code (src/game/) is only downloaded when someone presses the button.
 */
---
<div class="launch-slot">
  <button class="launch" type="button" data-game-launch aria-haspopup="dialog">
    <svg class="launch-ship" viewBox="-16 -19 32 42" width="40" height="52" aria-hidden="true">
      <path d="M0 -16 L4 -4 L13 10 L5 7 L3 12 L-3 12 L-5 7 L-13 10 L-4 -4 Z M0 -8 L2 -3 L0 1 L-2 -3 Z" />
      <path class="flame" d="M-3 13 L0 20 L3 13" />
    </svg>
    <span class="launch-text">
      <span class="launch-label">Play the demo</span>
      <span class="launch-hint">Fly · Type · Solve</span>
    </span>
  </button>
  <div class="squad-pill" data-squad-pill>
    <span class="squad-dot" aria-hidden="true"></span>
    <span data-squad-online>1 PILOT ONLINE</span>
    <span class="squad-sep" data-squad-sep aria-hidden="true" hidden>·</span>
    <span data-squad-top hidden></span>
  </div>
</div>

<div class="arcade" data-game-overlay hidden role="dialog" aria-modal="true" aria-label="Arcade demo: fly the ship, shoot the enemies, and type or solve sums to power up" tabindex="-1">
  <canvas class="arcade-canvas"></canvas>
  <div class="arcade-controls">
    <button class="arcade-btn arcade-icon arcade-ranks" type="button" data-game-ranks aria-label="Top 10 Pilots" aria-pressed="false" title="Top 10 Pilots (L)">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M12 4.5 L14.2 9 L19.2 9.7 L15.6 13.2 L16.5 18.2 L12 15.8 L7.5 18.2 L8.4 13.2 L4.8 9.7 L9.8 9 Z" />
      </svg>
    </button>
    <button class="arcade-btn arcade-icon arcade-pause" type="button" data-game-pause aria-label="Pause" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path class="bars" d="M9 6.5 V17.5 M15 6.5 V17.5" />
        <path class="play" d="M8.5 6 L17.5 12 L8.5 18 Z" />
      </svg>
    </button>
    <button class="arcade-btn arcade-icon arcade-sound" type="button" data-game-sound aria-label="Sound" aria-pressed="true">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 9.5 H7.5 L12 6 V18 L7.5 14.5 H4 Z" />
        <path class="waves" d="M15.5 9.5 Q17.5 12 15.5 14.5 M18 7 Q22 12 18 17" />
        <path class="cross" d="M15.5 9.5 L20.5 14.5 M20.5 9.5 L15.5 14.5" />
      </svg>
    </button>
    <button class="arcade-btn" type="button" data-game-exit>Exit</button>
  </div>
  <p class="visually-hidden" aria-live="polite" data-game-status></p>
</div>

<style>
  /* The hero's headline act: a neon-framed button on a line of its own above the other buttons. */
  .launch-slot {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .squad-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(4, 10, 40, 0.62);
    border: 1px solid rgba(126, 240, 247, 0.25);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sand) 85%, #7ef0f7);
    /* A long score or a big crowd wraps on to a second line on a phone instead of running off the screen. */
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
    text-align: center;
  }
  .squad-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #42f5ff;
    box-shadow: 0 0 8px #42f5ff;
    animation: breathe 2.4s ease-in-out infinite;
  }
  .squad-sep { opacity: 0.45; }
  .launch {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: min(100%, 360px);
    min-height: 64px;
    padding: 10px 26px 10px 20px;
    background: rgba(4, 10, 40, 0.78);
    border: 0;
    border-radius: 16px;
    color: var(--sand);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  /* A two-pixel frame that cycles through the game's neon colours. */
  .launch::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 2px;
    border-radius: inherit;
    background: conic-gradient(from var(--spin), #42f5ff, #b98cff, #ff5ea8, #ffe84a, #9bff4d, #42f5ff);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    animation: spin 5s linear infinite;
    pointer-events: none;
  }
  /* The same colours as a soft halo behind it. Only its opacity moves, which costs nothing to draw. */
  .launch::after {
    content: '';
    position: absolute;
    inset: -8px;
    z-index: -1;
    border-radius: 24px;
    background: conic-gradient(from 40deg, #42f5ff, #b98cff, #ff5ea8, #ffe84a, #9bff4d, #42f5ff);
    filter: blur(18px);
    opacity: 0.3;
    animation: breathe 2.6s ease-in-out infinite;
    pointer-events: none;
  }
  .launch-ship {
    flex: none;
    width: 30px;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px rgba(236, 223, 210, 0.7));
    animation: hover 2.4s ease-in-out infinite;
  }
  .flame {
    stroke: var(--accent-text);
    transform-box: fill-box;
    transform-origin: top;
    animation: flicker 0.16s steps(2, jump-none) infinite;
  }
  .launch-text { display: grid; gap: 5px; }
  .launch-label {
    font-family: var(--font-display);
    font-size: clamp(1rem, 4.4vw, 1.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 0 18px rgba(236, 223, 210, 0.55);
  }
  .launch-hint {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #7ef0f7;
  }
  .launch:active { transform: scale(0.98); }
  @media (hover: hover) {
    .launch:hover { transform: translateY(-2px); }
    .launch:hover::after { opacity: 0.6; animation: none; }
    .launch:hover .launch-ship { filter: drop-shadow(0 0 10px rgba(236, 223, 210, 1)); }
  }
  /* With room to spare it grows, and takes a little more air above the other buttons. */
  @media (min-width: 641px) and (min-height: 721px) {
    .launch { width: auto; min-height: 76px; padding: 12px 36px 12px 28px; gap: 20px; margin-bottom: 6px; }
    .launch-ship { width: 36px; }
    .launch-label { font-size: 1.35rem; }
    .launch-hint { font-size: 0.68rem; }
  }
  /* On very short, wide screens it joins the buttons' own row, so it costs no height at all. */
  @media (min-width: 641px) and (max-height: 720px) {
    .launch-slot { width: auto; }
    .launch { width: auto; min-height: 52px; padding: 6px 22px 6px 16px; gap: 12px; }
    .launch-ship { width: 22px; }
    .launch-label { font-size: 0.95rem; }
    .launch-hint, .squad-pill { display: none; }
  }
  /* Small phones: one line, to leave the rest of the hero its room. */
  @media (max-width: 420px) and (max-height: 700px) {
    .launch { min-height: 56px; }
    .launch-hint, .squad-pill { display: none; }
  }
  @property --spin { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --spin: 360deg; } }
  @keyframes breathe { 0%, 100% { opacity: 0.22; } 50% { opacity: 0.45; } }
  @keyframes hover { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes flicker { from { transform: scaleY(1); } to { transform: scaleY(0.55); } }

  /* While the game is open the ship has "left" the hero and the page behind is frozen. */
  :global(html.game-active) .launch,
  :global(html.game-active) .squad-pill { visibility: hidden; }
  :global(html.game-active) .launch::before,
  :global(html.game-active) .launch::after { animation: none; }
  :global(html.game-active .hero *) { animation-play-state: paused; }

  .arcade {
    position: fixed;
    inset: 0;
    z-index: 50;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    touch-action: none;
    outline: none;
    /* A finger held on the game steers the ship: it must not select text or bring up the phone's own menu. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .arcade[hidden] { display: none; }
  /* The backdrop is nearly opaque, so the site fades into the background instead of vanishing. */
  .arcade::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 55% at 50% 105%, rgba(95, 52, 117, 0.3), transparent 70%),
      rgba(3, 7, 26, 0.93);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .arcade.on::before { opacity: 1; }
  /* The canvas shows at once on open, so the ship carries straight over from the button; it fades on close. */
  .arcade-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .arcade.on .arcade-canvas { opacity: 1; transition: none; }
  .arcade-controls {
    position: absolute;
    top: calc(12px + env(safe-area-inset-top));
    right: calc(12px + env(safe-area-inset-right));
    display: flex;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .arcade.on .arcade-controls { opacity: 1; }
  .arcade-btn {
    display: grid;
    place-items: center;
    min-width: 64px;
    min-height: 44px;
    padding: 0 16px;
    background: transparent;
    color: var(--sand);
    border: 1px solid color-mix(in srgb, var(--sand) 55%, transparent);
    border-radius: 4px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  /* The icons are drawn like everything else in the game: thin lines, nothing filled. */
  .arcade-icon { min-width: 44px; padding: 0; }
  .arcade-icon svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  /* Pause shows two bars; while the game is paused it shows the triangle that starts it again. */
  .arcade-pause .play { display: none; }
  .arcade-pause[aria-pressed='true'] .bars { display: none; }
  .arcade-pause[aria-pressed='true'] .play { display: inline; }
  /* Narrow phones: three buttons have to fit beside the score. */
  @media (max-width: 420px) {
    .arcade-controls { gap: 6px; }
    .arcade-btn { min-width: 44px; padding: 0 10px; letter-spacing: 0.14em; }
    .arcade-icon { padding: 0; }
  }
  .arcade-ranks[aria-pressed='true'] { color: #42f5ff; border-color: #42f5ff; }
  .arcade-sound .cross { display: none; }
  .arcade-sound[aria-pressed='false'] { color: color-mix(in srgb, var(--sand) 60%, transparent); }
  .arcade-sound[aria-pressed='false'] .waves { display: none; }
  .arcade-sound[aria-pressed='false'] .cross { display: inline; }
  @media (hover: hover) {
    .arcade-btn:hover { background: color-mix(in srgb, var(--sand) 12%, transparent); border-color: var(--sand); }
  }

  @media (prefers-reduced-motion: reduce) {
    .launch-ship, .flame, .launch::before, .launch::after, .squad-dot { animation: none; }
  }
</style>

<script>
  import type { Game } from '../game/game';
  import type { MultiplayerClient } from '../game/multiplayer';

  const launch = document.querySelector<HTMLButtonElement>('[data-game-launch]');
  const overlay = document.querySelector<HTMLElement>('[data-game-overlay]');
  const canvas = overlay?.querySelector('canvas');
  const exit = overlay?.querySelector<HTMLButtonElement>('[data-game-exit]');
  const sound = overlay?.querySelector<HTMLButtonElement>('[data-game-sound]');
  const pause = overlay?.querySelector<HTMLButtonElement>('[data-game-pause]');
  const ranks = overlay?.querySelector<HTMLButtonElement>('[data-game-ranks]');
  const status = overlay?.querySelector<HTMLElement>('[data-game-status]');
  const squadOnline = document.querySelector<HTMLElement>('[data-squad-online]');
  const squadTop = document.querySelector<HTMLElement>('[data-squad-top]');
  const squadSep = document.querySelector<HTMLElement>('[data-squad-sep]');

  if (launch && overlay && canvas && exit) {
    // The overlay lives at the end of <body> so the rest of the page can be made inert around it.
    document.body.append(overlay);
    // Keep the page behind from scrolling without hiding its scrollbar, which would shift the layout.
    overlay.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });
    overlay.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });

    let game: Game | null = null;
    let mp: MultiplayerClient | null = null;
    let opening = false;

    const ensureMultiplayer = async (): Promise<MultiplayerClient> => {
      if (mp) return mp;
      const { MultiplayerClient } = await import('../game/multiplayer');
      mp = new MultiplayerClient();
      mp.subscribe((snap) => {
        if (squadOnline) {
          squadOnline.textContent = snap.onlineCount === 1 ? '1 PILOT ONLINE' : `${snap.onlineCount} PILOTS ONLINE`;
        }
        // The top pilot is only named once somebody has really flown a score on to the board.
        const top = snap.topPilots[0];
        if (squadTop) {
          squadTop.textContent = top ? `TOP PILOT: ${top.callsign} (${top.score.toLocaleString()})` : '';
          squadTop.hidden = !top;
        }
        if (squadSep) squadSep.hidden = !top;
      });
      mp.start();
      return mp;
    };

    // Hydrate the live pilot telemetry pill after initial paint without blocking first load.
    setTimeout(() => {
      void ensureMultiplayer();
    }, 600);

    const rest = () =>
      [...document.body.children].filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el !== overlay && el.tagName !== 'SCRIPT',
      );
    const announce = (active: boolean) =>
      document.dispatchEvent(new CustomEvent('gg:game', { detail: { active } }));

    const close = (viaBack = false) => {
      if (!game) return;
      game.destroy();
      game = null;
      overlay.classList.remove('on');
      document.documentElement.classList.remove('game-active');
      rest().forEach((el) => (el.inert = false));
      announce(false);
      launch.focus({ preventScroll: true });
      // Drop the history entry that open() added, unless the Back button has already done so.
      if (!viaBack && history.state?.ggGame) history.back();
      // Hide once the fade has finished, unless the game was reopened in the meantime.
      setTimeout(() => {
        if (!game) overlay.hidden = true;
      }, 600);
    };

    const open = async () => {
      if (game || opening) return;
      opening = true;
      // Safari and iPhones only let a page speak if it first does so during a click or tap. The game itself
      // loads a moment later, which is too late to count, so say nothing, silently, right here.
      try {
        if ('speechSynthesis' in window && localStorage.getItem('gg-arcade-sound') !== 'off') {
          const hush = new SpeechSynthesisUtterance(' ');
          hush.volume = 0;
          speechSynthesis.speak(hush);
        }
      } catch {
        /* no speech, or storage blocked: the game is silent or decides for itself */
      }
      try {
        const [{ Game }, multiplayer] = await Promise.all([
          import('../game/game'),
          ensureMultiplayer(),
        ]);
        overlay.hidden = false;
        document.documentElement.classList.add('game-active');
        rest().forEach((el) => (el.inert = true));
        announce(true);
        try {
          game = new Game(canvas, {
            multiplayer,
            onExit: () => close(),
            onStatus: (message) => {
              if (status) status.textContent = message;
            },
            // The game can pause itself (the P key, a hidden tab), so the button follows the game rather than the click.
            onPause: (paused) => {
              pause?.setAttribute('aria-pressed', String(paused));
              pause?.setAttribute('aria-label', paused ? 'Resume' : 'Pause');
            },
            onLeaderboard: (openState) => {
              ranks?.setAttribute('aria-pressed', String(openState));
            },
          });
          pause?.setAttribute('aria-pressed', 'false');
          pause?.setAttribute('aria-label', 'Pause');
          ranks?.setAttribute('aria-pressed', 'false');
        } catch (error) {
          // The game could not start (no canvas support, say): put the page back exactly as it was.
          overlay.hidden = true;
          document.documentElement.classList.remove('game-active');
          rest().forEach((el) => (el.inert = false));
          announce(false);
          console.error('The arcade demo could not start.', error);
          return;
        }
        // Give the game its own history entry, so Back (and the Android back gesture) closes it instead of leaving the site.
        history.pushState({ ggGame: true }, '');
        sound?.setAttribute('aria-pressed', String(game.soundOn));
        overlay.focus({ preventScroll: true });
        // Flush styles so the backdrop fades in from its hidden state.
        void overlay.offsetWidth;
        overlay.classList.add('on');
      } finally {
        opening = false;
      }
    };

    launch.addEventListener('click', open);
    exit.addEventListener('click', () => close());
    ranks?.addEventListener('click', () => {
      game?.toggleLeaderboard();
      overlay.focus({ preventScroll: true });
    });
    pause?.addEventListener('click', () => {
      game?.togglePause();
      overlay.focus({ preventScroll: true });
    });
    sound?.addEventListener('click', () => {
      if (!game) return;
      game.setSound(!game.soundOn);
      sound.setAttribute('aria-pressed', String(game.soundOn));
      // Hand the keyboard back to the game, so Enter and Space start and steer rather than press this button again.
      overlay.focus({ preventScroll: true });
    });
    addEventListener('popstate', () => close(true));
  }
</script>
