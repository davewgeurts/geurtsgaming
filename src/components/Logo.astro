---
/**
 * GeurtsGaming "gg" monogram.
 * Two lowercase g's standing back to back, like team-mates: sand on the left, and its mirror image
 * in magenta on the right, on a lapis→plum badge.
 * variant="badge" draws the rounded-square background; variant="mark" is just the letters.
 * The same drawing is kept as files in public/ (favicon.svg, logo.svg, apple-touch-icon.png, og.png).
 */
interface Props {
  size?: number | string;
  variant?: 'badge' | 'mark';
  class?: string;
  title?: string;
}
const { size = 64, variant = 'badge', class: className = '', title = 'GeurtsGaming' } = Astro.props;
const id = `gg-${Math.random().toString(36).slice(2, 8)}`;

// The left g: a round bowl (radius 14), then a straight back down its right side that hooks into a tail.
// The right g is the same path flipped left to right, so the two straight backs stand side by side.
const g = 'M 44.5 39 A 14 14 0 1 0 16.5 39 A 14 14 0 1 0 44.5 39 M 44.5 25 L 44.5 61 A 14 14 0 0 1 18.38 68';
const flip = 'translate(100 0) scale(-1 1)';
---

<svg
  class={`logo ${className}`}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-labelledby={`${id}-t`}
  xmlns="http://www.w3.org/2000/svg"
>
  <title id={`${id}-t`}>{title}</title>
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#213885" />
      <stop offset="1" stop-color="#5F3475" />
    </linearGradient>
  </defs>

  {variant === 'badge' && (
    <>
      <rect x="2" y="2" width="96" height="96" rx="24" fill={`url(#${id}-bg)`} />
      <rect x="2" y="2" width="96" height="96" rx="24" fill="none" stroke="#ECDFD2" stroke-opacity="0.18" stroke-width="2" />
    </>
  )}

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- a navy outline under both letters, which leaves a dark seam where their backs meet -->
    <path d={g} stroke="#081849" stroke-width="14" />
    <path d={g} stroke="#081849" stroke-width="14" transform={flip} />
    <!-- the mirrored g (magenta), then the g (sand) -->
    <path d={g} stroke="#893172" stroke-width="8" transform={flip} />
    <path d={g} stroke="#ECDFD2" stroke-width="8" />
  </g>
</svg>

<style>
  .logo { flex: none; }
</style>
