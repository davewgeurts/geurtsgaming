---
/** Ambient drifting particles behind the hero. Pauses for reduced-motion users, off-screen tabs and the arcade game. */
---
<canvas class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.starfield');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const colors = ['236,223,210', '137,49,114', '204,202,204', '95,52,117'];
    type P = { x: number; y: number; r: number; vy: number; a: number; c: string; streak: boolean };
    let w = 0, h = 0, dpr = 1, ps: P[] = [], raf = 0;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const make = (y?: number): P => {
      const streak = Math.random() < 0.12;
      return {
        x: rand(0, w),
        y: y ?? rand(0, h),
        r: streak ? rand(0.6, 1.2) : rand(0.6, 2.2),
        vy: streak ? rand(0.6, 1.6) : rand(0.08, 0.4),
        a: rand(0.15, 0.75),
        c: colors[Math.floor(Math.random() * colors.length)],
        streak,
      };
    };

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(220, Math.floor((w * h) / 9000));
      ps = Array.from({ length: n }, () => make());
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const p of ps) {
        ctx.fillStyle = `rgba(${p.c},${p.a})`;
        if (p.streak) {
          ctx.fillRect(p.x, p.y, p.r, 40 + p.vy * 30);
        } else {
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
        }
        if (!reduce) {
          p.y += p.vy;
          if (p.y > h + 60) Object.assign(p, make(-60));
        }
      }
      if (!reduce) raf = requestAnimationFrame(draw);
    };

    // The hero arcade game draws its own stars, so this one idles while the game is open.
    let gameOpen = false;
    const start = () => { cancelAnimationFrame(raf); if (!gameOpen) raf = requestAnimationFrame(draw); };
    document.addEventListener('gg:game', (e) => {
      gameOpen = (e as CustomEvent<{ active: boolean }>).detail.active;
      start();
    });
    resize(); start();
    addEventListener('resize', () => { resize(); if (reduce) draw(); }, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf); else start();
    });
  }
</script>
